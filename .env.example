# Copie para .env e preencha. NUNCA commite o .env.
NODE_ENV=development
PORT=3000

# Origens permitidas por CORS (separadas por vírgula). Vazio = mesma origem.
CORS_ORIGINS=

# Token para rotas administrativas (/api/admin/*). Gere algo longo e aleatório:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# --- Etapa 2 (Supabase) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Provedores de dados (preencher conforme cada etapa) ---
PANDASCORE_TOKEN=
FACEIT_API_KEY=
GRID_API_KEY=
# Cito API (citoapi.com) - chave do Console da API
CITO_API_KEY=
